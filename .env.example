OPENROUTER_API_KEY=your_openrouter_key_here
TAVILY_API_KEY=your_tavily_key_here

# Optional overrides - defaults live in app/config.py
# JEV_MODEL=typesafe/jev-1.13
# SMALL_LLM_MODEL=openai/gpt-5.6-luna
# STRONG_LLM_MODEL=openai/gpt-5.6-terra

# PostgreSQL (docker-compose provides this service as `postgres`;
# for a local, non-Docker run, point these at your own Postgres install)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=routeguard
DB_TEST_NAME=routeguard_test
DB_USER=routeguard
DB_PASSWORD=routeguard_dev_pw

# AWS deployment only (see README's "Deployed on AWS" section): instead of
# the plain vars above, set these to a Secrets Manager ARN and
# app/config.py fetches the real value at startup. Leave unset for local/
# Docker Compose use - the plain vars above take priority when both exist.
# OPENROUTER_API_KEY_SECRET_ARN=arn:aws:secretsmanager:...
# TAVILY_API_KEY_SECRET_ARN=arn:aws:secretsmanager:...
# DB_PASSWORD_SECRET_ARN=arn:aws:secretsmanager:...
